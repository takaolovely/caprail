# Execution mode: LOCAL_SIMULATION | CELO_MAINNET
EXECUTION_MODE=LOCAL_SIMULATION

# Celo Mainnet (Chain ID 42220) RPC URL
CELO_RPC_URL=https://forno.celo.org

# Celo ERC-8021 Builder Attribution Code (default official Loops House tag -> celo_0518175d3efe)
CELO_ATTRIBUTION_CODE=

# === HUMAN CONTROL PLANE (LOCAL OWNER MACHINE ONLY) ===
# Used ONLY for one-time `npm run session:grant` and 1-tx emergency revoke.
# NEVER copy OWNER_PRIVATE_KEY or ALTANA_ADMIN_PRIVATE_KEY to an autonomous agent / VPS host.
OWNER_PRIVATE_KEY=
ALTANA_ADMIN_PRIVATE_KEY=

# === AGENT EXECUTION PLANE (VPS / HERMES AGENT HOST) ===
# Output by `npm run session:grant`. The autonomous agent host receives ONLY these two values
# to run `npm run dca:tick -- --live` with zero access to the owner master key.
ALTANA_WALLET_ADDRESS=
ALTANA_SESSION_PRIVATE_KEY=

# External recipient address for Celo Mainnet ERC-8021 attribution transfer verification (`npm run live:test`)
TEST_RECIPIENT_ADDRESS=

# ERC-8004 Agent Identity Card URI (HTTPS or IPFS)
ERC8004_AGENT_CARD_URI=
