# Execution mode: LOCAL_SIMULATION | CELO_MAINNET
EXECUTION_MODE=LOCAL_SIMULATION

# Celo Mainnet (Chain ID 42220) RPC URL
CELO_RPC_URL=https://forno.celo.org

# Celo ERC-8021 Builder Attribution Code (from celo-org/attribution-tags)
CELO_ATTRIBUTION_CODE=

# Altana Agent Wallet configuration (ONLY required for CELO_MAINNET write operations)
# NEVER commit real private keys or session keys to git.
ALTANA_ADMIN_PRIVATE_KEY=
ALTANA_SESSION_PRIVATE_KEY=
ALTANA_WALLET_ADDRESS=

# ERC-8004 Agent Identity Card URI (HTTPS or IPFS)
ERC8004_AGENT_CARD_URI=
